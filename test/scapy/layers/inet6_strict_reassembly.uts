% Strict IPv6 reassembly tests (defragment6_strict)
% All packets are generated, serialized and re-parsed in-process.
% No network interface is used and no packet is ever sent.

############
############
+ Test defragment6_strict basic reassembly

= strict defrag - test helpers
import hashlib


def _sha(data):
    return hashlib.sha256(data).hexdigest()


def _udp_frags(src, dst, fid, payload, size=128, exthdrs=()):
    chain = IPv6(src=src, dst=dst)
    for hdr in exthdrs:
        chain = chain / hdr
    orig = chain / IPv6ExtHdrFragment(id=fid) / UDP(
        sport=1234, dport=4321) / Raw(load=payload)
    return orig, [IPv6(raw(f)) for f in fragment6(orig, size)]


assert _sha(b"x") == hashlib.sha256(b"x").hexdigest()

= strict defrag - out of order UDP fragments reassemble byte for byte
orig, frags = _udp_frags("2001:db8::1", "2001:db8::2", 100, b"U" * 500)
res = defragment6_strict(list(reversed(frags)))
assert len(res.reassembled) == 1
assert len(res.rejected) == 0
out = res.reassembled[0]
assert IPv6ExtHdrFragment not in out
assert out[IPv6].nh == 17
expected = raw(orig[IPv6ExtHdrFragment].payload)
got = raw(out[IPv6].payload)
assert got == expected
assert _sha(got) == _sha(expected)
assert out[IPv6].plen == len(expected)
assert out[UDP].dport == 4321
assert out[Raw].load == b"U" * 500

= strict defrag - TCP fragments keep exact upper-layer bytes and hash
tcp_orig = (IPv6(src="fe80::1", dst="fe80::2")
            / IPv6ExtHdrFragment(id=9) / TCP(sport=80, dport=8080)
            / Raw(load=b"T" * 400))
tfrags = [IPv6(raw(f)) for f in fragment6(tcp_orig, 100)]
res = defragment6_strict(
    sorted(tfrags, key=lambda p: -p[IPv6ExtHdrFragment].offset))
assert len(res.reassembled) == 1 and not res.rejected
t_out = res.reassembled[0]
assert t_out[IPv6].nh == 6 and TCP in t_out
t_expected = raw(tcp_orig[IPv6ExtHdrFragment].payload)
assert raw(t_out[IPv6].payload) == t_expected
assert _sha(raw(t_out[IPv6].payload)) == _sha(t_expected)

= strict defrag - two sources sharing an id complete independently
_, frags_a = _udp_frags("2001:db8::10", "2001:db8::20", 777, b"A" * 300)
_, frags_b = _udp_frags("2001:db8::30", "2001:db8::40", 777, b"B" * 300)
res = defragment6_strict(list(reversed(frags_a)) + list(reversed(frags_b)))
assert len(res.reassembled) == 2
assert not res.rejected
assert sorted(p[Raw].load for p in res.reassembled) == [b"A" * 300, b"B" * 300]

= strict defrag - non-fragment packets are ignored
res = defragment6_strict([IPv6() / UDP() / Raw(b"x"), IPv6() / TCP()])
assert not res.reassembled and not res.rejected

############
############
+ Test defragment6_strict RFC 5722 rejection rules

= strict defrag - any overlap discards the whole group
ov = [
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=10, offset=0, m=1) / Raw(b"0123456789abcdef"))),
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=10, offset=1, m=1) / Raw(b"XXXXXXXX"))),
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=10, offset=2, m=0) / Raw(b"YYYYYYYY"))),
]
res = defragment6_strict(ov)
assert not res.reassembled
assert len(res.rejected) == 1
assert res.rejected[0].reason == StrictIPv6ReasmError.OVERLAP
assert [(r.offset, r.length) for r in res.rejected[0].ranges] == [
    (0, 16), (8, 8), (16, 8)]

= strict defrag - a rejected group never blocks a healthy group
res = defragment6_strict(ov + frags)
assert len(res.reassembled) == 1
assert res.reassembled[0][Raw].load == b"U" * 500
assert len(res.rejected) == 1
assert res.rejected[0].reason == StrictIPv6ReasmError.OVERLAP

= strict defrag - an exact duplicate fragment is not accepted
dup = [
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=11, offset=0, m=1) / Raw(b"D" * 16))),
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=11, offset=0, m=1) / Raw(b"D" * 16))),
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=11, offset=2, m=0) / Raw(b"E" * 16))),
]
res = defragment6_strict(dup)
assert not res.reassembled
assert res.rejected[0].reason == StrictIPv6ReasmError.DUPLICATE

= strict defrag - same range with different bytes is an overlap
ov2 = list(dup)
ov2[1] = IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=11, offset=0, m=1) / Raw(b"F" * 16)))
assert defragment6_strict(ov2).rejected[0].reason == StrictIPv6ReasmError.OVERLAP

= strict defrag - a hole between ranges rejects the group
hole = [
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=12, offset=0, m=1) / Raw(b"G" * 16))),
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=12, offset=4, m=0) / Raw(b"H" * 16))),
]
assert defragment6_strict(hole).rejected[0].reason == StrictIPv6ReasmError.HOLE

= strict defrag - missing first fragment
no_first = [
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=13, offset=1, m=1) / Raw(b"a" * 8))),
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=13, offset=2, m=0) / Raw(b"b" * 8))),
]
assert defragment6_strict(no_first).rejected[0].reason == StrictIPv6ReasmError.NO_FIRST

= strict defrag - missing last fragment
no_last = [
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=14, offset=0, m=1) / Raw(b"c" * 8))),
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=14, offset=1, m=1) / Raw(b"d" * 8))),
]
assert defragment6_strict(no_last).rejected[0].reason == StrictIPv6ReasmError.NO_LAST

= strict defrag - several M=0 fragments
multi_last = [
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=15, offset=0, m=1) / Raw(b"e" * 8))),
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=15, offset=1, m=0) / Raw(b"f" * 8))),
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=15, offset=2, m=0) / Raw(b"g" * 8))),
]
assert defragment6_strict(multi_last).rejected[0].reason == StrictIPv6ReasmError.MULTIPLE_LAST

= strict defrag - non-last fragment length must be a multiple of 8
bad_len = [
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=16, offset=0, m=1) / Raw(b"1234567890"))),
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=16, offset=2, m=0) / Raw(b"h" * 8))),
]
assert defragment6_strict(bad_len).rejected[0].reason == StrictIPv6ReasmError.NON_LAST_NOT_MULT8

= strict defrag - last fragment is allowed a non multiple of 8 length
ok_tail = [
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=17, offset=0, m=1) / Raw(b"h" * 8))),
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=17, offset=1, m=0) / Raw(b"iii"))),
]
res = defragment6_strict(ok_tail)
assert len(res.reassembled) == 1 and not res.rejected
assert res.reassembled[0][Raw].load == b"h" * 8 + b"iii"

= strict defrag - offset exceeding the IPv6 payload length range
overflow = IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=18, offset=8191, m=1) / Raw(b"X" * 8)))
assert defragment6_strict([overflow]).rejected[0].reason == StrictIPv6ReasmError.OFFSET_OVERFLOW

= strict defrag - nested Fragment Header
nested = IPv6(raw(
    IPv6() / IPv6ExtHdrFragment(id=19, offset=0, m=0, nh=44)
    / IPv6ExtHdrFragment(id=20) / Raw(b"nested!")))
assert defragment6_strict([nested]).rejected[0].reason == StrictIPv6ReasmError.NESTED_FRAGHDR

############
############
+ Test defragment6_strict header consistency

= strict defrag - conflicting Fragment Header next-header values
nh_conflict = [
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=21, nh=17, offset=0, m=1) / Raw(b"k" * 8))),
    IPv6(raw(IPv6() / IPv6ExtHdrFragment(id=21, nh=6, offset=1, m=0) / Raw(b"l" * 8))),
]
assert defragment6_strict(nh_conflict).rejected[0].reason == StrictIPv6ReasmError.HEADER_CONFLICT

= strict defrag - conflicting unfragmentable extension header chain
chain_conflict = [
    IPv6(raw(IPv6() / IPv6ExtHdrHopByHop(options=[Pad1()])
             / IPv6ExtHdrFragment(id=22, nh=17, offset=0, m=1) / Raw(b"m" * 8))),
    IPv6(raw(IPv6() / IPv6ExtHdrHopByHop(options=[PadN(optdata=b"\x00" * 5)])
             / IPv6ExtHdrFragment(id=22, nh=17, offset=1, m=0) / Raw(b"n" * 8))),
]
assert defragment6_strict(chain_conflict).rejected[0].reason == StrictIPv6ReasmError.HEADER_CONFLICT

= strict defrag - extension headers before the Fragment Header are kept
ref = (IPv6(src="2001:db8::5", dst="2001:db8::6")
       / IPv6ExtHdrHopByHop(options=[Pad1()])
       / IPv6ExtHdrDestOpt(options=[PadN(optdata=b"\x00" * 3)])
       / UDP(sport=1234, dport=4321) / Raw(load=b"E" * 300))
_, ext_frags = _udp_frags(
    "2001:db8::5", "2001:db8::6", 555, b"E" * 300, size=120,
    exthdrs=(IPv6ExtHdrHopByHop(options=[Pad1()]),
             IPv6ExtHdrDestOpt(options=[PadN(optdata=b"\x00" * 3)])))
res = defragment6_strict(list(reversed(ext_frags)))
assert len(res.reassembled) == 1 and not res.rejected
o = res.reassembled[0]
assert IPv6ExtHdrHopByHop in o and IPv6ExtHdrDestOpt in o
assert IPv6ExtHdrFragment not in o
assert o[IPv6ExtHdrHopByHop].nh == 60
assert o[IPv6ExtHdrDestOpt].nh == 17
expected_ext = raw(ref[IPv6].payload)
assert raw(o[IPv6].payload) == expected_ext
assert _sha(raw(o[IPv6].payload)) == _sha(expected_ext)
assert o[IPv6].plen == len(raw(o[IPv6].payload))

############
############
+ Test defragment6_strict wire geometry

= strict defrag - link-layer tail padding is not consumed as data
l2_frags = []
for f in fragment6(
        Ether(src="00:11:22:33:44:55", dst="66:77:88:99:aa:bb")
        / IPv6(src="2001::9", dst="2001::a")
        / IPv6ExtHdrFragment(id=444)
        / UDP(sport=1, dport=2) / Raw(load=b"L" * 200), 120):
    l2_frags.append(Ether(raw(f) + b"\x00" * 6))

res = defragment6_strict(l2_frags)
assert len(res.reassembled) == 1 and not res.rejected
l2_out = res.reassembled[0]
assert Ether in l2_out and Padding not in l2_out
assert l2_out[Raw].load == b"L" * 200
assert l2_out[IPv6].plen == len(raw(l2_out[IPv6].payload))

= strict defrag - truncated remnant is rejected, no bytes invented
full = raw(IPv6() / IPv6ExtHdrFragment(id=445, offset=0, m=1) / Raw(b"S" * 16))
res = defragment6_strict([IPv6(full[:-6])])
assert not res.reassembled
assert res.rejected[0].reason == StrictIPv6ReasmError.BAD_PLEN

= strict defrag - oversized payload length field is rejected
import struct as _struct
tampered = bytearray(full)
old_plen = _struct.unpack("!H", bytes(tampered[4:6]))[0]
tampered[4:6] = _struct.pack("!H", old_plen + 20)
res = defragment6_strict([IPv6(bytes(tampered))])
assert not res.reassembled
assert res.rejected[0].reason == StrictIPv6ReasmError.BAD_PLEN

############
############
+ Test defragment6_strict RFC 6946 atomic fragments

= strict defrag - an atomic fragment is a standalone complete datagram
atom = IPv6(raw(
    IPv6(src="2001:db8::1", dst="2001:db8::2")
    / IPv6ExtHdrFragment(id=333, offset=0, m=0)
    / UDP(sport=9, dport=99) / Raw(b"atomic-data")))
res = defragment6_strict([atom])
assert len(res.reassembled) == 1 and not res.rejected
a_out = res.reassembled[0]
assert IPv6ExtHdrFragment not in a_out and a_out[IPv6].nh == 17
assert raw(a_out[IPv6].payload) == raw(atom[IPv6ExtHdrFragment].payload)
assert a_out.plen == len(raw(atom[IPv6ExtHdrFragment].payload))

= strict defrag - atomic and regular fragments with the same id coexist
_, regular = _udp_frags("2001:db8::1", "2001:db8::2", 333, b"R" * 200)
res = defragment6_strict([atom] + regular)
assert len(res.reassembled) == 2 and not res.rejected
assert sorted(len(p[Raw].load) for p in res.reassembled) == [11, 200]

= strict defrag - a rejected regular group does not taint the atomic one
bad_regular = [
    IPv6(raw(IPv6(src="2001:db8::1", dst="2001:db8::2")
             / IPv6ExtHdrFragment(id=333, offset=0, m=1) / Raw(b"o" * 16))),
    IPv6(raw(IPv6(src="2001:db8::1", dst="2001:db8::2")
             / IPv6ExtHdrFragment(id=333, offset=4, m=0) / Raw(b"p" * 8))),
]
res = defragment6_strict([atom] + bad_regular)
assert any(p[Raw].load == b"atomic-data" for p in res.reassembled)
assert len(res.rejected) == 1
assert res.rejected[0].reason == StrictIPv6ReasmError.HOLE

= strict defrag - two atomic datagrams sharing an id are both delivered
atom2 = IPv6(raw(
    IPv6(src="2001:db8::1", dst="2001:db8::2")
    / IPv6ExtHdrFragment(id=333, offset=0, m=0)
    / UDP(sport=9, dport=99) / Raw(b"atomic-two")))
res = defragment6_strict([atom, atom2] + regular)
assert len(res.reassembled) == 3 and not res.rejected
atomic_loads = sorted(
    p[Raw].load for p in res.reassembled if len(p[Raw].load) in (11, 10))
assert atomic_loads == [b"atomic-data", b"atomic-two"]
assert any(p[Raw].load == b"R" * 200 for p in res.reassembled)

############
############
+ Test defragment6_strict resource limits

= strict defrag - max_groups boundary and overflow
g1 = _udp_frags("2001::1", "2001::2", 601, b"a" * 100, size=64)[1]
g2 = _udp_frags("2001::3", "2001::4", 602, b"b" * 100, size=64)[1]
g3 = _udp_frags("2001::5", "2001::6", 603, b"c" * 100, size=64)[1]
assert len(defragment6_strict(g1 + g2 + g3, max_groups=3).reassembled) == 3
res = defragment6_strict(g1 + g2 + g3, max_groups=2)
assert len(res.reassembled) == 2
assert res.rejected[0].reason == StrictIPv6ReasmError.LIMIT_GROUPS

= strict defrag - max_fragments_per_group boundary and overflow
big = _udp_frags("2001::7", "2001::8", 604, b"z" * 400, size=64)[1]
n_frag = len(big)
assert len(defragment6_strict(big, max_fragments_per_group=n_frag).reassembled) == 1
res = defragment6_strict(big, max_fragments_per_group=n_frag - 1)
assert not res.reassembled
assert res.rejected[0].reason == StrictIPv6ReasmError.LIMIT_FRAGMENTS

= strict defrag - cumulative fragment byte budget boundary and overflow
total_bytes = sum(p[IPv6].plen - 8 for p in g1)
assert len(defragment6_strict(
    g1, max_total_fragment_bytes=total_bytes).reassembled) == 1
res = defragment6_strict(g1, max_total_fragment_bytes=total_bytes - 1)
assert not res.reassembled
assert res.rejected[0].reason == StrictIPv6ReasmError.LIMIT_BYTES

= strict defrag - byte budget overflow leaves the sibling group intact
res = defragment6_strict(g2 + g1, max_total_fragment_bytes=total_bytes)
assert len(res.reassembled) == 1
assert res.reassembled[0][Raw].load == b"b" * 100
assert res.rejected[0].reason == StrictIPv6ReasmError.LIMIT_BYTES

= strict defrag - negative limits raise ValueError
raised = False
try:
    defragment6_strict([], max_groups=-1)
except ValueError:
    raised = True

assert raised

= strict defrag - atomic datagrams are counted by max_groups
res = defragment6_strict([atom, atom2], max_groups=1)
assert len(res.reassembled) == 1
assert res.rejected[0].reason == StrictIPv6ReasmError.LIMIT_GROUPS

############
############
+ Test defragment6_strict safety properties

= strict defrag - input packets and their caches are never modified
_, imm_frags = _udp_frags("2001::a", "2001::b", 700, b"I" * 200)
before_bytes = [raw(p) for p in imm_frags]
before_nh = [p[IPv6ExtHdrFragment].underlayer.nh for p in imm_frags]
defragment6_strict(list(reversed(imm_frags)))
assert [raw(p) for p in imm_frags] == before_bytes
assert [p[IPv6ExtHdrFragment].underlayer.nh for p in imm_frags] == before_nh

= strict defrag - rejection reports only carry identity ranges and reason
import dataclasses as _dc
rep = defragment6_strict(ov).rejected[0]
assert {f.name for f in _dc.fields(rep)} == {"group", "reason", "ranges", "detail"}
assert (rep.group.src, rep.group.dst, rep.group.frag_id) == ("::1", "::1", 10)
assert all(isinstance(r, StrictIPv6ReasmRange) and
           isinstance(r.offset, int) and isinstance(r.length, int)
           for r in rep.ranges)

= strict defrag - one mixed batch keeps every healthy group independent
_, fa = _udp_frags("2001:db8::10", "2001:db8::20", 777, b"A" * 300)
batch = (list(reversed(frags)) + list(reversed(fa)) + ov + dup + hole +
         [atom] + regular + l2_frags + [IPv6(full[:-6])] + [nested])
res = defragment6_strict(batch)
reasons = sorted(r.reason.name for r in res.rejected)
for name in ("OVERLAP", "DUPLICATE", "HOLE", "BAD_PLEN", "NESTED_FRAGHDR"):
    assert name in reasons

assert len(res.reassembled) >= 4
for p in res.reassembled:
    assert IPv6ExtHdrFragment not in p
    assert p[IPv6].plen == len(raw(p[IPv6].payload))

= strict defrag - the legacy loose defragment6 function is unchanged
loose = defragment6(frags)
assert loose[Raw].load == b"U" * 500
